{{- $name := .Site.Params.pwaName | default .Site.Title -}}
{{- $shortName := .Site.Params.pwaShortName | default .Site.Params.shortName | default .Site.Title -}}
{{- $description := .Site.Params.description | default $name -}}
{{- $themeColor := .Site.Params.themeColor | default "#121212" -}}
{
  "name": {{ $name | jsonify | safeJS }},
  "short_name": {{ $shortName | jsonify | safeJS }},
  "description": {{ $description | jsonify | safeJS }},
  "start_url": {{ "/" | relURL | jsonify | safeJS }},
  "scope": {{ "/" | relURL | jsonify | safeJS }},
  "display": "standalone",
  "background_color": {{ $themeColor | jsonify | safeJS }},
  "theme_color": {{ $themeColor | jsonify | safeJS }},
  "icons": [
    {
      "src": {{ .Site.Params.faviconSvg | default "favicon.svg" | relURL | jsonify | safeJS }},
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
