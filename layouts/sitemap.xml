{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ .Site.Home.Permalink }}</loc>
    <lastmod>{{ now.Format "2006-01-02T15:04:05Z07:00" }}</lastmod>
  </url>
  {{- $seen := dict -}}
  {{- range partial "public-pages.html" .Site.RegularPages }}
  {{- if not (index $seen .Permalink) }}
  {{- $seen = merge $seen (dict .Permalink true) }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</lastmod>
    {{- end }}
  </url>
  {{- end }}
  {{- end }}
</urlset>
